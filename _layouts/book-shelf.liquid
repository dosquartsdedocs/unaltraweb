---
layout: page
---
{{ content }}

{% assign current_lang = page.lang | default: site.default_lang | default: site.lang %}

{% capture empty_shelf_text %}{% include t.liquid key='reading.empty_shelf' default='No reading notes available yet.' %}{% endcapture %}
{% capture uncategorized_text %}{% include t.liquid key='reading.uncategorized' default='Uncategorized' %}{% endcapture %}
{% capture not_dated_text %}{% include t.liquid key='reading.not_dated' default='n.d.' %}{% endcapture %}
{% capture collections_text %}{% include t.liquid key='reading.collections' default='Collections' %}{% endcapture %}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% assign localized_items = collection | where: 'lang', current_lang %}
  {% if localized_items.size == 0 and current_lang != site.default_lang %}
    {% assign localized_items = collection | where: 'lang', site.default_lang %}
  {% endif %}
  {% if localized_items.size == 0 %}
    {% assign localized_items = collection | where_exp: 'item', 'item.lang == nil' %}
  {% endif %}

  {% assign sorted_items = localized_items | sort: 'date' | reverse %}

  {% if sorted_items.size > 0 %}
    {% assign collection_groups = sorted_items | group_by_exp: 'item', 'item.collection_ref | default: item.collection_name | default: item.series | default: uncategorized_text' %}

    {% if collection_groups.size > 1 %}
      <nav class="reading-collection-index" aria-label="{{ collections_text | strip }}">
        <strong>{{ collections_text | strip }}</strong>
        <ol>
          {% for group in collection_groups %}
            {% assign collection_label_key = 'collection_' | append: current_lang %}
            {% assign collection_label_source = group.items | first %}
            {% assign collection_label = collection_label_source[collection_label_key] | default: collection_label_source.collection_name | default: collection_label_source.series | default: group.name | default: uncategorized_text %}
            <li><a href="#reading-collection-{{ group.name | slugify }}">{{ collection_label }}</a></li>
          {% endfor %}
        </ol>
      </nav>
    {% endif %}

    {% for group in collection_groups %}
      {% assign collection_label_key = 'collection_' | append: current_lang %}
      {% assign collection_label_source = group.items | first %}
      {% assign collection_label = collection_label_source[collection_label_key] | default: collection_label_source.collection_name | default: collection_label_source.series | default: group.name | default: uncategorized_text %}
      {% assign show_collection_heading = false %}
      {% if collection_groups.size > 1 or collection_label != uncategorized_text %}
        {% assign show_collection_heading = true %}
      {% endif %}

      <section class="reading-collection"{% if show_collection_heading %} aria-labelledby="reading-collection-{{ group.name | slugify }}"{% endif %}>
        {% if show_collection_heading %}
          <h2 id="reading-collection-{{ group.name | slugify }}" class="reading-collection-title">{{ collection_label }}</h2>
        {% endif %}

        <div class="reading-shelf">
      {% for item in group.items %}
        {% include reading-cover-card.liquid item=item current_lang=current_lang %}
      {% endfor %}
        </div>
      </section>
    {% endfor %}
  {% else %}
    <p>{{ empty_shelf_text | strip }}</p>
  {% endif %}
{% endif %}
