---
---
{% assign current_lang = page.lang | default: site.default_lang | default: site.lang %}
{% assign comment_key = 'manual_comment_' | append: current_lang %}
{% assign kind_key = 'manual_kind_' | append: current_lang %}
{% assign reference_comment = entry[comment_key] | default: entry.manual_comment | default: entry.comment %}
{% assign reference_kind = entry[kind_key] | default: entry.manual_kind | default: entry.type %}
{% assign reference_rating = entry.manual_rating | default: entry.rating %}
{% assign reference_preview = entry.preview | default: entry.image | default: entry.thumbnail %}
{% assign reference_url = entry.manual_url | default: entry.website | default: entry.url %}
{% assign reference_url_label_key = 'manual_url_label_' | append: current_lang %}
{% assign reference_url_label = entry[reference_url_label_key] | default: entry.manual_url_label %}
{% capture reference_authors %}
  {%- for author in entry.author_array -%}
    {{- author.first }} {{ author.last -}}{% unless forloop.last %}, {% endunless %}
  {%- endfor -%}
{% endcapture %}
{% assign reference_authors = reference_authors | strip | default: entry.author %}
{% capture metadata_text %}{% include t.liquid key='manual.metadata' default='Metadata' %}{% endcapture %}
{% capture authors_text %}{% include t.liquid key='manual.authors' default='Authors' %}{% endcapture %}
{% capture abstract_text %}{% include t.liquid key='manual.abstract' default='Abstract' %}{% endcapture %}
{% capture how_to_cite_text %}{% include t.liquid key='manual.how_to_cite_apa' default='How to cite (APA)' %}{% endcapture %}
{% capture year_text %}{% include t.liquid key='reading.year' default='Year' %}{% endcapture %}
{% capture doi_text %}{% include t.liquid key='reading.doi' default='DOI' %}{% endcapture %}
{% capture isbn_text %}{% include t.liquid key='reading.isbn' default='ISBN' %}{% endcapture %}
{% capture publisher_text %}{% include t.liquid key='reading.publisher' default='Publisher' %}{% endcapture %}
{% capture links_text %}{% include t.liquid key='reading.links' default='Links' %}{% endcapture %}
<div id="{{ entry.key }}" class="manual-reference{% if reference_preview %} manual-reference--with-preview{% endif %}">
  {% if reference_preview %}
    <div class="manual-reference-preview">
      {% if reference_preview contains '://' %}
        <img src="{{ reference_preview }}" alt="" data-zoomable>
      {% else %}
        {% assign reference_preview_path = reference_preview %}
        {% unless reference_preview_path contains '/' %}
          {% assign reference_preview_path = reference_preview_path | prepend: '/assets/img/publication_preview/' %}
        {% endunless %}
        {%
          include figure.liquid
          loading="eager"
          path=reference_preview_path
          sizes="160px"
          class="manual-reference-preview-image"
          zoomable=true
          avoid_scaling=true
          alt=reference_preview
        %}
      {% endif %}
    </div>
  {% endif %}
  <div class="manual-reference-body">
    {% if reference_kind or reference_rating %}
      <div class="manual-reference-meta">
        {% if reference_kind %}<span>{{ reference_kind }}</span>{% endif %}
        {% if reference_rating %}<span class="reading-rating"><i class="fa-solid fa-star" aria-hidden="true"></i>{{ reference_rating }}/5</span>{% endif %}
      </div>
    {% endif %}
    <div class="manual-reference-text">{{ reference | replace: "\Textperiodcentered", "·" }}</div>
    {% if reference_comment %}<div class="manual-reference-comment">{{ reference_comment | markdownify }}</div>{% endif %}
    <details class="manual-reference-details">
      <summary>{{ metadata_text | strip }}</summary>
      <dl class="manual-reference-details-list">
        {% if reference_authors %}<dt>{{ authors_text | strip }}</dt><dd>{{ reference_authors }}</dd>{% endif %}
        {% if entry.year %}<dt>{{ year_text | strip }}</dt><dd>{{ entry.year }}</dd>{% endif %}
        {% if entry.publisher %}<dt>{{ publisher_text | strip }}</dt><dd>{{ entry.publisher }}</dd>{% endif %}
        {% if entry.isbn %}<dt>{{ isbn_text | strip }}</dt><dd>{{ entry.isbn }}</dd>{% endif %}
        {% if entry.doi %}<dt>{{ doi_text | strip }}</dt><dd><a href="https://doi.org/{{ entry.doi }}">{{ entry.doi }}</a></dd>{% endif %}
        {% if reference_url %}<dt>{{ links_text | strip }}</dt><dd><a href="{{ reference_url }}">{{ reference_url_label | default: reference_url }}</a></dd>{% endif %}
      </dl>
      {% if entry.abstract %}<div class="manual-reference-abstract"><h4>{{ abstract_text | strip }}</h4><p>{{ entry.abstract }}</p></div>{% endif %}
      <div class="manual-reference-citation"><h4>{{ how_to_cite_text | strip }}</h4><p>{{ reference | replace: "\Textperiodcentered", "·" }}</p></div>
    </details>
  </div>
</div>
