ARG UNALTRAWEB_RUNTIME_IMAGE=ghcr.io/dosquartsdedocs/unaltraweb:0.7.2
FROM ${UNALTRAWEB_RUNTIME_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/dosquartsdedocs/unaltraweb"

ENV PYTHONUNBUFFERED=1 \
    UNALTRAWEB_FACTORY_DIR=/opt/unaltraweb \
    UNALTRAWEB_DOCKER_ROOT=/workspace

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends docker-cli libcairo2 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY . /opt/unaltraweb
RUN python3 -m pip install --no-cache-dir --break-system-packages "/opt/unaltraweb[mcp]" \
    && chmod -R a+rX /opt/unaltraweb

# The private QGIS verifier is delegated to the hub-prepared native controller.
# No private wheel, source, credential or image is fetched into this public image.

WORKDIR /workspace
ENTRYPOINT ["unaltraweb-mcp"]
CMD ["--project", "/workspace", "mcp", "serve"]
