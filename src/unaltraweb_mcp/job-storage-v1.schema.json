{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dosquartsdedocs/gacontext/job-storage-v1.schema.json",
  "title": "gaContExt W1 job volumes, retention evidence and release observations",
  "description": "Separate from legacy workspace_rule and artifact handoff v1. Observations and reference plans do not authorize Docker mutations.",
  "oneOf": [
    {"$ref": "#/$defs/provider"},
    {"$ref": "#/$defs/state"},
    {"$ref": "#/$defs/retention"},
    {"$ref": "#/$defs/binding"},
    {"$ref": "#/$defs/request"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "time": {"type": "string", "minLength": 20, "maxLength": 40, "format": "date-time"},
    "daemon": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:._-]+$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
    "role": {"enum": ["scratch", "retained"]},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "type", "role", "cleanup"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "type": {"const": "directory"},
        "role": {"enum": ["input-snapshots", "results", "sealed-products", "recovery", "regenerable"]},
        "cleanup": {"enum": ["resolved-retention", "on-release"]}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_scratch_bytes", "max_retained_bytes", "max_entries", "max_jobs", "min_free_bytes", "monitor_interval_seconds", "quota_enforcement"],
      "properties": {
        "max_scratch_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "max_retained_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "max_entries": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_jobs": {"type": "integer", "minimum": 1, "maximum": 128},
        "min_free_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "monitor_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 10},
        "quota_enforcement": {"enum": ["monitored", "hard"]}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract", "provider", "storage_tool", "job_root", "scratch_root", "path_policies", "limits"],
      "properties": {
        "kind": {"const": "gacontext.job-storage-provider"}, "schema_version": {"type": "integer", "const": 1},
        "contract": {"const": "docker-job-volumes-v1"}, "provider": {"$ref": "#/$defs/name"},
        "storage_tool": {"const": "job_storage"}, "job_root": {"const": "/work"}, "scratch_root": {"const": "/work/scratch"},
        "path_policies": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/policy"}},
        "limits": {"$ref": "#/$defs/limits"}
      }
    },
    "lease": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "state"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["client", "task", "writer", "reader", "transfer"]}, "state": {"enum": ["active", "released", "unknown"]}}
    },
    "volume": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "role", "daemon_id", "driver", "created_at", "marker_sha256", "labels", "state", "observed_at", "attachments_complete", "attachments", "bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "pattern": "^gacontext-job-[0-9a-f]{32}$"}, "role": {"$ref": "#/$defs/role"},
        "daemon_id": {"$ref": "#/$defs/daemon"}, "driver": {"const": "local"}, "created_at": {"$ref": "#/$defs/time"},
        "marker_sha256": {"$ref": "#/$defs/hash"},
        "labels": {"type": "object", "additionalProperties": false,
          "required": ["io.context.mcp-storage.contract", "io.context.mcp-storage.registry", "io.context.mcp-storage.provider", "io.context.mcp-storage.binding", "io.context.mcp-storage.job", "io.context.mcp-storage.volume", "io.context.mcp-storage.role"],
          "properties": {
            "io.context.mcp-storage.contract": {"const": "docker-job-volumes-v1"},
            "io.context.mcp-storage.registry": {"$ref": "#/$defs/id"}, "io.context.mcp-storage.provider": {"$ref": "#/$defs/name"},
            "io.context.mcp-storage.binding": {"$ref": "#/$defs/id"}, "io.context.mcp-storage.job": {"$ref": "#/$defs/id"},
            "io.context.mcp-storage.volume": {"$ref": "#/$defs/id"}, "io.context.mcp-storage.role": {"$ref": "#/$defs/role"}
          }},
        "state": {"enum": ["verified", "unknown", "absent"]}, "observed_at": {"$ref": "#/$defs/time"},
        "attachments_complete": {"type": "boolean"},
        "attachments": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "bytes": {"oneOf": [{"$ref": "#/$defs/bytes"}, {"type": "null"}]}
      }
    },
    "product": {
      "type": "object", "additionalProperties": false, "required": ["id", "bundle_sha256", "disposition", "decision"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "bundle_sha256": {"$ref": "#/$defs/hash"}, "disposition": {"enum": ["pending", "acknowledged", "discarded"]},
        "decision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decision"}]}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "evidence_sha256", "bundle_sha256", "verified_at", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["retention", "user-discard"]},
        "evidence_sha256": {"$ref": "#/$defs/hash"}, "bundle_sha256": {"$ref": "#/$defs/hash"},
        "verified_at": {"$ref": "#/$defs/time"}, "status": {"enum": ["verified", "stale", "unknown"]}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "contract", "registry_id", "job_id", "binding_id", "provider", "provider_sha256", "daemon_id", "revision", "epoch", "observed_at", "phase", "activity", "limits", "leases_complete", "leases", "volumes", "products", "holds", "protected_inventory"],
      "properties": {
        "kind": {"const": "gacontext.job-storage-state"}, "schema_version": {"type": "integer", "const": 1},
        "contract": {"const": "docker-job-volumes-v1"},
        "registry_id": {"$ref": "#/$defs/id"}, "job_id": {"$ref": "#/$defs/id"}, "binding_id": {"$ref": "#/$defs/id"},
        "provider": {"$ref": "#/$defs/name"}, "provider_sha256": {"$ref": "#/$defs/hash"}, "daemon_id": {"$ref": "#/$defs/daemon"},
        "revision": {"type": "integer", "minimum": 1}, "epoch": {"type": "integer", "minimum": 1}, "observed_at": {"$ref": "#/$defs/time"},
        "phase": {"enum": ["open", "draining", "closed", "releasing", "released"]}, "activity": {"enum": ["idle", "busy", "unknown"]},
        "limits": {"$ref": "#/$defs/limits"},
        "leases_complete": {"type": "boolean"}, "leases": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/lease"}},
        "volumes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/volume"}},
        "products": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/product"}},
        "holds": {"type": "array", "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "reason"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "reason": {"enum": ["unsealed-source", "unsealed-result", "recovery", "unknown-content", "destination-unavailable"]}}
        }},
        "protected_inventory": {"type": "object", "additionalProperties": false, "required": ["state", "tree_sha256", "unresolved_entries"],
          "properties": {"state": {"enum": ["verified", "unknown"]}, "tree_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "unresolved_entries": {"type": "integer", "minimum": 0, "maximum": 1000000}}}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "registry_id", "job_id", "product_id", "bundle_sha256", "receiver_binding_id", "destination", "domain_profile", "domain_check_sha256", "verified_at"],
      "properties": {
        "kind": {"const": "gacontext.job-product-retention"}, "schema_version": {"type": "integer", "const": 1},
        "registry_id": {"$ref": "#/$defs/id"}, "job_id": {"$ref": "#/$defs/id"}, "product_id": {"$ref": "#/$defs/id"},
        "bundle_sha256": {"$ref": "#/$defs/hash"}, "receiver_binding_id": {"$ref": "#/$defs/id"},
        "destination": {"type": "object", "additionalProperties": false, "required": ["path", "format", "content_sha256"],
          "properties": {"path": {"$ref": "#/$defs/path"}, "format": {"enum": ["directory", "tar-gzip", "zip"]}, "content_sha256": {"$ref": "#/$defs/hash"}}},
        "domain_profile": {"$ref": "#/$defs/name"}, "domain_check_sha256": {"$ref": "#/$defs/hash"}, "verified_at": {"$ref": "#/$defs/time"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "registry_id", "job_id", "binding_id", "provider", "provider_sha256", "daemon_id", "epoch", "lease_id", "access", "job_root", "mounts"],
      "properties": {
        "kind": {"const": "gacontext.job-storage-binding"}, "schema_version": {"type": "integer", "const": 1},
        "registry_id": {"$ref": "#/$defs/id"}, "job_id": {"$ref": "#/$defs/id"}, "binding_id": {"$ref": "#/$defs/id"},
        "provider": {"$ref": "#/$defs/name"}, "provider_sha256": {"$ref": "#/$defs/hash"}, "daemon_id": {"$ref": "#/$defs/daemon"},
        "epoch": {"type": "integer", "minimum": 1}, "lease_id": {"$ref": "#/$defs/id"},
        "access": {"enum": ["read-only", "read-write"]}, "job_root": {"const": "/work"},
        "mounts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "role", "marker_sha256"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "pattern": "^gacontext-job-[0-9a-f]{32}$"},
                         "role": {"$ref": "#/$defs/role"}, "marker_sha256": {"$ref": "#/$defs/hash"}}
        }}
      }
    },
    "request": {"oneOf": [{"$ref": "#/$defs/status_request"}, {"$ref": "#/$defs/mutation_request"}]},
    "status_request": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "operation", "registry_id", "job_id"],
      "properties": {
        "kind": {"const": "gacontext.job-storage-request"}, "schema_version": {"type": "integer", "const": 1},
        "operation": {"const": "status"}, "registry_id": {"$ref": "#/$defs/id"}, "job_id": {"$ref": "#/$defs/id"}
      }
    },
    "mutation_request": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "operation", "registry_id", "job_id", "expected_revision", "expected_epoch"],
      "properties": {
        "kind": {"const": "gacontext.job-storage-request"}, "schema_version": {"type": "integer", "const": 1},
        "operation": {"enum": ["quiesce", "seal"]}, "registry_id": {"$ref": "#/$defs/id"}, "job_id": {"$ref": "#/$defs/id"},
        "expected_revision": {"type": "integer", "minimum": 1}, "expected_epoch": {"type": "integer", "minimum": 1}
      }
    }
  }
}
