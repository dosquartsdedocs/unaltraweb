{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gacontext.benizar.com/schemas/product-publication-v1",
  "title": "Selected product publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "producer", "project_id", "product_id", "audience", "files"],
  "properties": {
    "kind": {"const": "gacontext.product-manifest"},
    "schema_version": {"type": "integer", "const": 1},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "revision"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "revision": {"type": "string", "pattern": "^(git:([0-9a-f]{40}|[0-9a-f]{64})|sha256:[0-9a-f]{64})$"}
      }
    },
    "project_id": {"$ref": "#/$defs/token"},
    "product_id": {"$ref": "#/$defs/token"},
    "audience": {"enum": ["public", "private", "student", "teacher"]},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "output"}}},
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "media_type", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 21474836480},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"},
          "role": {"enum": ["output", "evidence"]}
        }
      }
    },
    "native": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "manifest_sha256"],
      "properties": {
        "format": {"$ref": "#/$defs/token"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {"token": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"}}
}
