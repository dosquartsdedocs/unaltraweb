{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-artifact practice storage v2: repository buckets and explicit access capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "consumer_repository", "publication", "artifacts"],
  "properties": {
    "kind": {"const": "unaltraweb.practice-artifact-storage"},
    "schema_version": {"type": "integer", "const": 2},
    "consumer_repository": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false, "required": ["remote", "host", "repository"],
      "properties": {
        "remote": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
        "host": {"enum": ["github.com", "bitbucket.org"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$"}
      }
    }]},
    "publication": {"oneOf": [{"type": "null"}, {"$ref": "publication-policy-v1.schema.json"}]},
    "artifacts": {
      "type": "object", "maxProperties": 256,
      "propertyNames": {"pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "audience", "receipt", "receipt_sha256", "format", "storage_profile"],
        "properties": {
          "target": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"},
          "audience": {"enum": ["public", "private", "student", "teacher"]},
          "receipt": {"type": "string", "minLength": 1, "maxLength": 1024},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "format": {"enum": ["zip", "pdf"]},
          "storage_profile": {"enum": ["anonymous-delivery-v1", "authenticated-private-v1"]}
        }
      }
    }
  }
}
