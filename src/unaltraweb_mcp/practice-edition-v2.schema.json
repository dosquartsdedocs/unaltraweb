{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unaltraweb private tabular practice edition v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "mode", "slug", "version", "language", "materials", "readings", "selection"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "kind": {"const": "unaltraweb-practice-edition"},
    "mode": {"const": "tabular"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "language": {"type": "string", "enum": ["ca", "es", "en"]},
    "materials": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/material"}},
    "readings": {
      "type": "object", "additionalProperties": false, "required": ["alumnat", "docent"],
      "properties": {"alumnat": {"$ref": "#/$defs/reading"}, "docent": {"$ref": "#/$defs/reading"}}
    },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["alumnat", "docent"],
      "properties": {"alumnat": {"$ref": "#/$defs/roots"}, "docent": {"$ref": "#/$defs/roots"}}
    },
    "resources": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/resource"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$"},
    "roots": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/id"}},
    "recipients": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"enum": ["alumnat", "docent"]}},
    "material": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "destination", "sha256", "bytes", "role", "recipients"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}, "destination": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "role": {"enum": ["initial-data", "initial-workbook", "resolved-workbook", "demonstration-workbook", "reference-document"]},
        "recipients": {"$ref": "#/$defs/recipients"}
      }
    },
    "reading": {
      "type": "object", "additionalProperties": false, "required": ["source", "approved_sha256"],
      "properties": {"source": {"$ref": "#/$defs/path"}, "approved_sha256": {"$ref": "#/$defs/hash"},
        "bindings": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/binding"}}}
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["reference", "sha256"],
      "oneOf": [{"required": ["path"]}, {"required": ["product"]}],
      "properties": {"reference": {"type": "string", "minLength": 1, "maxLength": 1024}, "path": {"$ref": "#/$defs/path"},
        "product": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/hash"}, "destination": {"$ref": "#/$defs/path"}}
    },
    "dependency": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "destination"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "destination": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "destination", "role", "recipients", "dependencies"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "destination": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"},
        "role": {"const": "editable-infographic"}, "recipients": {"$ref": "#/$defs/recipients"},
        "dependencies": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/dependency"}}
      }
    }
  }
}
