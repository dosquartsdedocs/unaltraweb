{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Producer-resolved manual context v1 (Itemarium consumer proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "producer", "manual", "exported_at", "chapters", "figures", "files"],
  "properties": {
    "format": {"const": "unaltraweb-manual-context"},
    "format_version": {"const": 1},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "revision"],
      "properties": {"name": {"const": "unaltraweb"}, "version": {"$ref": "#/$defs/label"}, "revision": {"$ref": "#/$defs/label"}}
    },
    "manual": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "language", "revision", "source_sha256", "source_date", "dirty"],
      "properties": {
        "id": {"$ref": "#/$defs/label"}, "title": {"$ref": "#/$defs/label"},
        "language": {"type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{2,8}){0,2}$"},
        "revision": {"$ref": "#/$defs/label"}, "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_date": {"type": "string", "format": "date-time"}, "dirty": {"type": "boolean"}
      }
    },
    "exported_at": {"type": "string", "format": "date-time"},
    "chapters": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "title", "order", "source_sha256", "sections"],
        "properties": {
          "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"},
          "title": {"$ref": "#/$defs/label"}, "order": {"type": "integer", "minimum": 0},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "sections": {
            "type": "array", "minItems": 1, "maxItems": 2000,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "title", "level", "path"],
              "properties": {"id": {"$ref": "#/$defs/label"}, "title": {"$ref": "#/$defs/label"}, "level": {"type": "integer", "minimum": 0, "maximum": 6}, "path": {"$ref": "#/$defs/path"}}
            }
          }
        }
      }
    },
    "figures": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "alt", "caption", "credits", "language", "source", "resolution"],
        "properties": {
          "id": {"$ref": "#/$defs/label"}, "path": {"$ref": "#/$defs/path"},
          "alt": {"$ref": "#/$defs/text"}, "caption": {"$ref": "#/$defs/text"}, "credits": {"$ref": "#/$defs/text"},
          "language": {"type": "string", "minLength": 2, "maxLength": 30},
          "source": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
          },
          "resolution": {
            "type": "object", "additionalProperties": false, "required": ["kind", "edited"],
            "properties": {"kind": {"enum": ["static", "computation", "diagram", "vega", "web-capture", "qgis-capture"]}, "edited": {"type": "boolean"}, "receipt_sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    },
    "files": {
      "type": "object", "minProperties": 1, "maxProperties": 10000,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["sha256", "size_bytes"],
        "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760}}
      }
    }
  },
  "$defs": {
    "label": {"type": "string", "minLength": 1, "maxLength": 300},
    "text": {"type": "string", "maxLength": 4000},
    "path": {"type": "string", "minLength": 1, "maxLength": 240},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
