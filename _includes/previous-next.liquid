{% assign items = include.items %}
{% assign current_url = include.current_url | default: page.url %}
{% assign previous_item = nil %}
{% assign next_item = nil %}
{% assign current_seen = false %}
{% for item in items %}
  {% if current_seen and next_item == nil %}
    {% assign next_item = item %}
  {% endif %}
  {% if item.url == current_url %}
    {% assign current_seen = true %}
  {% elsif current_seen == false %}
    {% assign previous_item = item %}
  {% endif %}
{% endfor %}
{% capture previous_text %}{% include t.liquid key='navigation.previous' default='Previous' %}{% endcapture %}
{% capture next_text %}{% include t.liquid key='navigation.next' default='Next' %}{% endcapture %}
{% assign aria_label = include.aria_label | default: 'Page navigation' %}

{% if previous_item or next_item %}
  <nav class="previous-next-nav{% if include.class %} {{ include.class }}{% endif %}" aria-label="{{ aria_label | escape }}">
    {% if previous_item %}
      <a class="previous-next-link previous" href="{{ previous_item.url | relative_url }}">
        <span>{{ previous_text | strip }}</span>
        <strong>{{ previous_item.nav_title | default: previous_item.title }}</strong>
      </a>
    {% else %}
      <span></span>
    {% endif %}
    {% if next_item %}
      <a class="previous-next-link next" href="{{ next_item.url | relative_url }}">
        <span>{{ next_text | strip }}</span>
        <strong>{{ next_item.nav_title | default: next_item.title }}</strong>
      </a>
    {% endif %}
  </nav>
{% endif %}
